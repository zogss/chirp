    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.4",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.22.2",
    "emoji-regex": "^10.6.0",
    "motion": "^13.2.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "server-only": "^0.0.1",
